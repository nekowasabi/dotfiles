#!/usr/bin/env python3
"""Strip shared TUI padding and rejoin wrapped URLs from tmux copy-pipe input."""

from __future__ import annotations

import re
import sys

# Why: full-string match after join — only a URL-only selection is rewritten.
_URL = re.compile(r"^https?://\S+$")


def _leading_ws_len(line: str) -> int:
    i = 0
    while i < len(line) and line[i] in " \t":
        i += 1
    return i


def strip_common_indent(text: str) -> str:
    lines = text.splitlines()
    nonempty = [line for line in lines if line.strip()]
    # Why: single-line copy keeps its own indent (code snippet). Shared TUI
    # padding only appears across 2+ lines.
    if len(nonempty) < 2:
        return text
    n = min(_leading_ws_len(line) for line in nonempty)
    if n == 0:
        return text
    stripped = [line[n:] if len(line) >= n else line for line in lines]
    result = "\n".join(stripped)
    if text.endswith("\n") or text.endswith("\r\n"):
        result += "\n"
    return result


def join_wrapped_url(text: str) -> str:
    # Why: join only when the whole selection is a URL. Mid-token wraps
    # (https://ex.com/filena + me.ts) are the TUI case; paragraphs stay split.
    ended_with_nl = text.endswith("\n") or text.endswith("\r\n")
    lines = text.splitlines()
    if len(lines) < 2:
        return text
    if any(line.strip() == "" for line in lines):
        return text
    trimmed = [line.rstrip() for line in lines]
    joined = "".join(trimmed)
    if not _URL.match(joined):
        return text
    if not trimmed[0].startswith(("http://", "https://")):
        return text
    result = joined
    if ended_with_nl:
        result += "\n"
    return result


def filter_text(text: str) -> str:
    if not text:
        return text
    # Why: normalize CRLF from WSL/win32yank paths before indent math
    normalized = text.replace("\r\n", "\n").replace("\r", "\n")
    ended_with_nl = text.endswith("\n") or text.endswith("\r\n")
    stripped = strip_common_indent(normalized)
    joined = join_wrapped_url(stripped)
    if ended_with_nl and not joined.endswith("\n"):
        joined += "\n"
    if not ended_with_nl and joined.endswith("\n"):
        joined = joined[:-1]
    return joined


def main() -> None:
    sys.stdout.write(filter_text(sys.stdin.read()))


if __name__ == "__main__":
    main()
